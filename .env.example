# Front-end server settings. Copy to .env.local and fill in; never commit real values.
# Read on the server at request time (not NEXT_PUBLIC_, never sent to the browser).

# Where the proxy sends /api/* (the API's base address, no trailing slash). Locally: http://localhost:8010
# On Windows use http://127.0.0.1:8010 instead of localhost: localhost tries IPv6 first and adds about 220 ms to every request.
HIS_API_URL=

# The key that signs the `his_session` cookie. Must be the same value as HIS_SESSION_COOKIE_KEY on the API.
# Generate a long random string; changing it signs everybody out. Leave empty and every page treats you as signed out.
HIS_SESSION_COOKIE_KEY=

# "api" (default) = real sign-in on the API. "mock" = front-end-only sign-in with sample data, for working without the API.
HIS_AUTH_MODE=api
